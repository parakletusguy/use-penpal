NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
PENPAL_EDITOR_EMAIL=your-editor-email@example.com
OPENAI_API_KEY=your-openai-api-key
# Optional: PenPal defaults to gpt-4o-mini for the MVP.
OPENAI_MODEL=gpt-4o-mini
# Recommended for polite Crossref metadata lookups (for example, editor@ijsds.org).
CROSSREF_MAILTO=editor@example.com
# Optional Drive delivery. Share the fixed output folder with this service account;
# keep the JSON credential server-side and never use a NEXT_PUBLIC_ variable.
PENPAL_DRIVE_OUTPUT_FOLDER_ID=your-approved-output-folder-id
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Resend sends editor-only alerts from a verified PenPal subdomain.
RESEND_API_KEY=your-resend-api-key
PENPAL_ALERT_FROM="PenPal Editorial <alerts@penpal.ijsds.org>"
PENPAL_APP_URL=https://use-penpal.vercel.app
